# Step 9: Chroma 商品向量召回配置

# local: 使用本地 hash embedding，不调用外部 API，适合先跑通项目
# qwen : 调用千问 / DashScope text-embedding-v4
# auto : 有真实 DASHSCOPE_API_KEY 时调用千问，否则使用 local
PRODUCT_VECTOR_EMBEDDING_PROVIDER=local

# 千问 / 阿里云百炼 DashScope API Key
# 要使用千问时，把 provider 改成 qwen 或 auto，并替换下面的占位符
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 当前代码默认使用：
# endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# model: text-embedding-v4
# dimensions: 1024

# Step 10: Redis 在线画像缓存 + 实时行为窗口
REDIS_URL=redis://localhost:6379/0
FEATURE_STORE_PROFILE_TTL_SECONDS=600
FEATURE_STORE_BEHAVIOR_TTL_SECONDS=604800

# Step 11: LLM 用户画像分析（OpenAI 兼容）
# 通用配置优先级最高，适合千问、DeepSeek 或其他兼容服务
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=15
# Qwen3/Qwen3.5 等 thinking 模型建议关闭，避免 content 为空或 JSON 输出不稳定
LLM_ENABLE_THINKING=false

# DeepSeek 示例
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 千问 / 阿里云百炼 OpenAI-compatible 示例
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
