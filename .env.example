# Step 9: Chroma 商品向量召回配置

# local: 使用本地 hash embedding，不调用外部 API，适合先跑通项目
# qwen : 调用千问 / DashScope text-embedding-v4
# auto : 有真实 DASHSCOPE_API_KEY 时调用千问，否则使用 local
PRODUCT_VECTOR_EMBEDDING_PROVIDER=local

# 千问 / 阿里云百炼 DashScope API Key
# 要使用千问时，把 provider 改成 qwen 或 auto，并替换下面的占位符
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 当前代码默认使用：
# endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# model: text-embedding-v4
# dimensions: 1024

# Step 10: Redis 在线画像缓存 + 实时行为窗口
REDIS_URL=redis://localhost:6379/0
FEATURE_STORE_PROFILE_TTL_SECONDS=600
FEATURE_STORE_BEHAVIOR_TTL_SECONDS=604800
